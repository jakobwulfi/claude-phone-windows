{
  "name": "claude-phone",
  "displayName": "claude-phone",
  "description": "Lets the claude-phone daemon type phone messages into Claude Code sessions running in VS Code terminals, and lists the sessions with their extensions.",
  "version": "0.2.0",
  "publisher": "jakobwulfi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakobwulfi/claude-phone-windows"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudePhone.showSessions",
        "title": "claude-phone: Show sessions"
      }
    ],
    "configuration": {
      "title": "claude-phone",
      "properties": {
        "claudePhone.daemonPort": {
          "type": "number",
          "default": 8765,
          "description": "Port of the claude-phone daemon on 127.0.0.1 (daemon_port in ~/.claude-phone/config.toml)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
